# Salin ke .env.local lalu isi. Jangan commit nilai asli.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FREE_PROMO=false
USER_DEFAULT_TIMEZONE=Asia/Jakarta

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# LLM parser (OpenAI-compatible)
LLM_BASE_URL=https://kenari.id/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-1-flash

# Cron & endpoint setup webhook
CRON_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# Opsional
SENTRY_AUTH_TOKEN=
DUITKU_API_KEY=
DUITKU_MERCHANT_CODE=
